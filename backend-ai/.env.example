# Salin menjadi .env (JANGAN di-commit)

# --- Server ---
PORT=5000
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10

# --- AI ---
# Di bawah ambang ini, hasil CNN ditandai "tidak yakin"
CONFIDENCE_THRESHOLD=0.60

# --- LLM: pilih salah satu: gemini | groq | ollama ---
LLM_PROVIDER=gemini
LLM_API_KEY=

LLM_MODEL=
OLLAMA_URL=http://localhost:11434

# --- IPFS (Pinata) ---
PINATA_JWT=
IPFS_GATEWAY=